# 复制为 .env.local 后按需修改（.env.local 不入库）
# 指向任一 S3 兼容服务：MinIO / AWS S3 / 阿里 OSS（S3 兼容层）/ s3rver（见 README）
VITE_S3_ENDPOINT=http://localhost:9000
VITE_S3_REGION=us-east-1
VITE_S3_BUCKET=mmagic-demo
VITE_S3_PREFIX=
VITE_S3_ACCESS_KEY_ID=minioadmin
VITE_S3_ACCESS_KEY_SECRET=minioadmin
# STS 临时凭证模式才需要；本地 AK/SK 长期凭证留空
VITE_S3_SESSION_TOKEN=
# MMagic-Files 前端地址（iframe 内嵌目标，默认本机 :5199 dev server）
# VITE_MMFILES_BASE=http://localhost:5199/
