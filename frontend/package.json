{
  "name": "mmagic-files",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint \"src/**/*.vue\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vue-tsc -b --noEmit && eslint \"src/**/*.vue\" && vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "~1.18.1",
    "element-plus": "^2.13.3",
    "pinia": "^3.0.4",
    "remixicon": "^4.9.1",
    "sass": "^1.97.3",
    "uuid": "^14.0.1",
    "vue": "^3.5.25",
    "vue-i18n": "^9.14.4",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^19.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.5"
  }
}
